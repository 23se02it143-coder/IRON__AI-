# Copy to .env and edit. Every value is optional in development.
# Comments must stay on their own lines (a comment after a value becomes part of the value).

# development | production | test
ENVIRONMENT=development
# Public URL, used in emails and cookies (https:// makes cookies Secure)
BASE_URL=http://localhost:8000
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Leave empty for local SQLite in ./data. Postgres example: postgresql+psycopg://user:pass@host/db
DATABASE_URL=

APP_NAME=IRON-AI
COMPANY_NAME=Divya Solanki
SUPPORT_EMAIL=divyasolanki10125@gmail.com
# Where contact-form messages AND "someone paid" notifications are emailed
CONTACT_INBOX=divyasolanki10125@gmail.com

# First admin, created on startup if none exists. In development one is generated and printed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# If true, "/" redirects anyone not signed in to /welcome (sign in or create an account) before they see
# the site at all. Off by default: most people selling a subscription want visitors to see pricing and
# features before signing up. Turn this on only if you specifically want an invite-only / members-only site.
REQUIRE_LOGIN=false

WAITLIST_DOUBLE_OPT_IN=false
# Hide the public sign-up counter until this many people confirmed
WAITLIST_PUBLIC_COUNT_MIN=25

# Set to false in production to skip placeholder testimonials
SEED_SAMPLE_CONTENT=true

CURRENCY=INR
# mock (test-mode checkout, no money) | stripe | razorpay
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
# Webhook URL: {BASE_URL}/api/billing/webhook/stripe
STRIPE_WEBHOOK_SECRET=

# --- Razorpay --------------------------------------------------------------
# 1. Sign up at https://dashboard.razorpay.com and finish KYC (needed before you can accept real money).
# 2. Settings > API Keys > Generate Key. Start with the TEST mode keys (they start with rzp_test_)
#    and switch to the LIVE keys (rzp_live_) only once you've tried a real test payment end to end.
# 3. Settings > Webhooks > Add New Webhook:
#      URL:    {BASE_URL}/api/billing/webhook/razorpay   (must be a public https:// URL, not localhost)
#      Secret: any string you choose - paste the same value into RAZORPAY_WEBHOOK_SECRET below
#      Active events: payment_link.paid, payment_link.expired, payment_link.cancelled
# Until a public HTTPS URL exists (e.g. after deploying, or via a tunnel like ngrok while testing),
# the webhook can't reach this app, so payments won't be marked paid automatically - leave
# PAYMENTS_PROVIDER=mock while developing locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Without SMTP_HOST every email is only recorded in the outbox (viewable in /admin)
EMAIL_FROM=IRON-AI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls

# auto = use the LLM when ANTHROPIC_API_KEY is set, otherwise the built-in rules engine
# auto | rules | anthropic
ASSISTANT_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

RATE_LIMIT_ENABLED=true
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
